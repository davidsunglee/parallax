{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallax.dev/schemas/conformance-adapter.schema.json",
  "title": "Parallax Conformance Adapter Output",
  "description": "JSON output emitted by a language implementation conformance adapter. The adapter is the `m-conformance-adapter` seam used by external runners to ask a concrete language implementation what it supports, what SQL it emits for a compatibility case, and what observations it produces when it runs a case.",
  "oneOf": [
    { "$ref": "#/$defs/describeOk" },
    { "$ref": "#/$defs/compileOk" },
    { "$ref": "#/$defs/compileRunOnly" },
    { "$ref": "#/$defs/runOk" },
    { "$ref": "#/$defs/benchmarkOk" },
    { "$ref": "#/$defs/nonOk" }
  ],
  "$defs": {
    "storedDataRecord": {
      "description": "One result position a read classified rather than published as itself. `ordinal` is its zero-based place in the ordered result, `hydrated` states whether the normative collapse produced a value at that position, and `issues` is the deduplicated diagnosis set the position carries.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "hydrated", "issues"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "hydrated": { "type": "boolean" },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/storedDataIssue" }
        }
      }
    },
    "storedDataIssue": {
      "description": "One stored-data violation: its closed `code`, the canonical `entity` it was found on, the dotted `member` path where one is nameable, and the affected `objectKey` where the object's own identity decoded.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "entity"],
      "properties": {
        "code": {
          "enum": [
            "stored-data-required-member-absent",
            "stored-data-required-member-null",
            "stored-data-one-wrong-kind",
            "stored-data-many-wrong-kind",
            "stored-data-leaf-undecodable",
            "stored-data-attribute-null",
            "stored-data-family-tag-unknown",
            "stored-data-primary-key-null",
            "stored-data-primary-key-undecodable"
          ]
        },
        "entity": { "type": "string", "minLength": 1 },
        "member": { "type": "string", "minLength": 1 },
        "objectKey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity", "key"],
          "properties": {
            "entity": { "type": "string", "minLength": 1 },
            "key": { "type": "object", "minProperties": 1 }
          }
        }
      }
    },
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "command": {
      "type": "string",
      "enum": ["describe", "compile", "run", "benchmark"]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "name", "version"],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dialect": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "casePath": {
      "type": "string",
      "pattern": "^(core/compatibility/cases/|cases/).+\\.ya?ml$"
    },
    "benchmarkPath": {
      "type": "string",
      "pattern": "^(core/compatibility/benchmarks/|benchmarks/).+\\.ya?ml$"
    },
    "caseShape": {
      "type": "string",
      "enum": ["read", "writeSequence", "scenario", "conflict", "coherence", "error", "concurrencySuccess", "boundary", "rejected"]
    },
    "moduleTag": {
      "type": "string",
      "pattern": "^m-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "caseShapeList": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseShape" },
      "uniqueItems": true
    },
    "caseTag": {
      "description": "A compatibility case tag from a case's `tags` array.",
      "type": "string",
      "minLength": 1
    },
    "caseTagList": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseTag" },
      "uniqueItems": true
    },
    "caseTagClaims": {
      "description": "Optional tag filters that narrow broad module/case-shape claims. `include` means a case must have at least one listed tag; `exclude` means a case with any listed tag is outside the claim.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["include"] },
        { "required": ["exclude"] }
      ],
      "properties": {
        "include": { "$ref": "#/$defs/caseTagList" },
        "exclude": { "$ref": "#/$defs/caseTagList" }
      }
    },
    "commandList": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" },
      "uniqueItems": true
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "casePointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "details": {}
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^($|/.*)$"
    },
    "bindValue": {
      "description": "A JSON-serializable bind value. Objects and arrays are allowed for structured-document values such as JSON, JSONB, or VARIANT.",
      "type": ["string", "number", "boolean", "null", "object", "array"]
    },
    "binds": {
      "type": "array",
      "items": { "$ref": "#/$defs/bindValue" }
    },
    "emission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["casePointer", "sql", "binds"],
      "properties": {
        "casePointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "binds": {
          "$ref": "#/$defs/binds"
        }
      }
    },
    "emissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/emission" }
    },
    "row": {
      "type": "object",
      "additionalProperties": true
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "identityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "same"],
      "properties": {
        "left": {
          "$ref": "#/$defs/jsonPointer"
        },
        "right": {
          "$ref": "#/$defs/jsonPointer"
        },
        "same": {
          "type": "boolean"
        },
        "identity": {}
      }
    },
    "stateCheck": {
      "description": "A lifecycle-state observation (m-conformance-adapter): the object at case position `at` was observed in a given lifecycle state, and `pass` records whether that matched the case's `expectState`. `at` is a JSON Pointer into the case (a scenario step index). Mirrors `identityCheck`'s explicit-verdict shape so the runner grades an assertion the wire golden SQL cannot see.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "expected", "observed", "pass"],
      "properties": {
        "at": {
          "$ref": "#/$defs/jsonPointer"
        },
        "expected": {
          "type": "string",
          "enum": ["in-memory", "persisted", "deleted", "detached", "detached-deleted"]
        },
        "observed": {
          "type": "string"
        },
        "pass": {
          "type": "boolean"
        }
      }
    },
    "errorObservation": {
      "description": "A raised-application-error observation (m-conformance-adapter): the verb at case position `at` raised the neutral application-lifecycle error `errorClass`, from the closed vocabulary the case's `expectError` names (m-detach / m-identity-map / m-unit-work). Distinct from the m-db-error taxonomy; `native` optionally carries the implementation's raw error payload as an unconstrained witness.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "errorClass"],
      "properties": {
        "at": {
          "$ref": "#/$defs/jsonPointer"
        },
        "errorClass": {
          "type": "string",
          "enum": [
            "detached-relationship-load",
            "transaction-time-pin-read-only",
            "write-value-not-stored",
            "write-value-already-stored",
            "write-value-foreign-lifecycle"
          ]
        },
        "native": {}
      }
    },
    "stepGraphObservation": {
      "description": "The relationship contents observed at ONE scenario step declaring `expectGraph` (m-case-format): `at` is the JSON Pointer naming the step, and `graph` the contents that step's access observed, keyed by the traversed relationship's target Entity under its local name. The contents are the ones the implementation's own materialized graph holds at that step, never a re-read — an adapter that re-queries reports that the database is right while the case asks whether the view survived.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "graph"],
      "properties": {
        "at": {
          "$ref": "#/$defs/jsonPointer"
        },
        "graph": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": { "type": ["object", "null"] }
          }
        }
      }
    },
    "milestoneGraphObservation": {
      "description": "One edge-pinned graph in the ordered observation for a milestone-set snapshot read. The pin is the milestone's own from-instant per as-of axis, keyed by as-of attribute name; graph has the same root-class-keyed shape as a single graph observation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pin", "graph"],
      "properties": {
        "pin": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "graph": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "databaseCall": {
      "description": "One attempted database round trip an adapter observed (m-execution-log Database Call). Mirrors the compatibility case's `databaseCall`: `statement` is the zero-based index into this envelope's own `emissions` array, so the observation names the statement a call ran instead of repeating its SQL and binds, and is omitted only where the envelope reports no emissions at all (a case on the `api-conformance` lane), where `kind` and `completion` are the whole observation. `kind` keeps a failed call classifiable without parsing SQL.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "completion"],
      "properties": {
        "statement": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": ["read", "write"]
        },
        "completion": { "$ref": "#/$defs/callCompletion" }
      },
      "allOf": [
        {
          "description": "A `read` call admits Read Completed or Database Call Failed; a `write` call admits Write Completed or Database Call Failed. The observation is closed over the same call algebra as the case oracle, so a mirror comparison never has to reject a pair the oracle could not have authored.",
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "read" } }
          },
          "then": {
            "properties": { "completion": { "not": { "required": ["writeCompleted"] } } }
          },
          "else": {
            "properties": { "completion": { "not": { "required": ["readCompleted"] } } }
          }
        }
      ]
    },
    "callCompletion": {
      "description": "How an observed Database Call ended — a closed union of exactly one member, mirroring the case oracle. `readCompleted.returnedRows` is the physical row count the statement returned; `writeCompleted.affectedRows` the affected count; `failed.category` the neutral m-db-error category the failure classified to, null where it classified to none.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["readCompleted"], "propertyNames": { "enum": ["readCompleted"] } },
        { "required": ["writeCompleted"], "propertyNames": { "enum": ["writeCompleted"] } },
        { "required": ["failed"], "propertyNames": { "enum": ["failed"] } }
      ],
      "properties": {
        "readCompleted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["returnedRows"],
          "properties": { "returnedRows": { "type": "integer", "minimum": 0 } }
        },
        "writeCompleted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["affectedRows"],
          "properties": { "affectedRows": { "type": "integer", "minimum": 0 } }
        },
        "failed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category"],
          "properties": {
            "category": { "enum": ["uniqueViolation", "deadlock", "lockWaitTimeout", null] }
          }
        }
      }
    },
    "readTrace": {
      "description": "The calls one observed read issued (m-execution-log Read Trace); non-empty by invariant.",
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "roundTrips"],
      "properties": {
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/databaseCall" }
        },
        "roundTrips": { "type": "integer", "minimum": 1 }
      }
    },
    "writeBatchTrace": {
      "description": "The calls one observed write batch issued, naming the closed m-unit-work trigger that produced it (`read-dependency` / `finalization`); non-empty by invariant.",
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "calls", "roundTrips"],
      "properties": {
        "trigger": {
          "enum": ["read-dependency", "finalization"]
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/databaseCall" }
        },
        "roundTrips": { "type": "integer", "minimum": 1 }
      }
    },
    "attemptTrace": {
      "description": "One entry in an observed attempt's ordered traces: exactly one `readTrace` or `writeBatch`.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["readTrace"], "propertyNames": { "enum": ["readTrace"] } },
        { "required": ["writeBatch"], "propertyNames": { "enum": ["writeBatch"] } }
      ],
      "properties": {
        "readTrace": { "$ref": "#/$defs/readTrace" },
        "writeBatch": { "$ref": "#/$defs/writeBatchTrace" }
      }
    },
    "attemptFailure": {
      "description": "The detached diagnostic an observed rolled-back attempt retained. `phase` locates a failure with no call; `retryEligible` is the classifier's verdict under the effective policy, independent of the remaining budget; `databaseCall` indexes this attempt's own flattened calls. The implementation-level error type name and message are not portable and are absent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "retryEligible"],
      "properties": {
        "phase": {
          "enum": ["body", "finalization", "commit"]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "retryEligible": { "type": "boolean" },
        "databaseCall": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "description": "A `commit` failure references no Database Call: the durability boundary is not a recorded call, so an index reported beside `phase: commit` names an unrelated statement.",
          "if": {
            "required": ["phase"],
            "properties": { "phase": { "const": "commit" } }
          },
          "then": { "not": { "required": ["databaseCall"] } }
        }
      ]
    },
    "transactionAttempt": {
      "description": "One observed physical attempt of the logical invocation. `roundTrips` counts every attempted call, a failed one included, and excludes begin / commit / rollback. `status` omits the live `active` value: an adapter reports once the invocation has terminated, so every attempt it observes has already transitioned. A `failure` belongs to a rolled-back attempt alone, mirroring the case oracle's own conditional.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "traces", "roundTrips"],
      "properties": {
        "status": {
          "enum": ["committed", "rolled-back"]
        },
        "traces": {
          "type": "array",
          "items": { "$ref": "#/$defs/attemptTrace" }
        },
        "roundTrips": { "type": "integer", "minimum": 0 },
        "failure": { "$ref": "#/$defs/attemptFailure" }
      },
      "allOf": [
        {
          "description": "Only a rolled-back attempt carries a failure: reporting one beside `committed` states two outcomes for one attempt.",
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "rolled-back" } }
          },
          "else": { "not": { "required": ["failure"] } }
        }
      ]
    },
    "retryPolicy": {
      "description": "The resolved effective Retry Policy the observed Execution Log retained once.",
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRetries", "retryOptimisticConflicts"],
      "properties": {
        "maxRetries": { "type": "integer", "minimum": 0 },
        "retryOptimisticConflicts": { "type": "boolean" }
      }
    },
    "transactionLog": {
      "description": "The whole observed Execution Log of one logical transaction invocation, spanning every physical attempt including a joined body's.",
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "retryPolicy", "attempts", "roundTrips"],
      "properties": {
        "concurrency": {
          "enum": ["locking", "optimistic"]
        },
        "retryPolicy": { "$ref": "#/$defs/retryPolicy" },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transactionAttempt" }
        },
        "roundTrips": { "type": "integer", "minimum": 0 }
      }
    },
    "executionObservation": {
      "description": "The execution provenance an adapter observed (m-execution-log), in the same closed-union shape the case's `then.execution` oracle authors: exactly one `readTrace` for a standalone read, or one `transactionLog` for a transactional run. A runner compares it structurally against `then.execution`, which is why the two shapes mirror each other rather than each choosing its own spelling.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["readTrace"], "propertyNames": { "enum": ["readTrace"] } },
        { "required": ["transactionLog"], "propertyNames": { "enum": ["transactionLog"] } }
      ],
      "properties": {
        "readTrace": { "$ref": "#/$defs/readTrace" },
        "transactionLog": { "$ref": "#/$defs/transactionLog" }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roundTrips"],
      "properties": {
        "rows": {
          "$ref": "#/$defs/rows"
        },
        "graph": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "graphs": {
          "description": "The ordered per-milestone snapshot graphs produced by a history or asOfRange read, compared entry-for-entry with the case's then.graphs oracle.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/milestoneGraphObservation" }
        },
        "tableState": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/row" }
          }
        },
        "affectedRows": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "roundTrips": {
          "type": "integer",
          "minimum": 0
        },
        "identityChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/identityCheck" }
        },
        "storedDataIssues": {
          "description": "The stored-data diagnoses a read published for the result positions whose stored state contradicted the declared model (m-snapshot-read), compared against the case's `then.storedDataIssues`. Optional and additive — a conforming read publishes none and omits it, and existing run outputs stay valid.",
          "type": "array",
          "items": { "$ref": "#/$defs/storedDataRecord" }
        },
        "stateChecks": {
          "description": "Lifecycle-state checks (m-detach five-state machine) an adapter reports for scenario steps declaring `expectState`. Optional and additive — an adapter that reports no lifecycle state omits it, and existing run outputs stay valid.",
          "type": "array",
          "items": { "$ref": "#/$defs/stateCheck" }
        },
        "stepGraphs": {
          "description": "The relationship contents an adapter observed at each scenario step declaring `expectGraph` (m-case-format), in step order. A scenario has no single whole-read graph, so these ride their own per-step key rather than the whole-read `graph` member. Optional and additive — a run whose case declares no `expectGraph` omits it, and existing run outputs stay valid.",
          "type": "array",
          "items": { "$ref": "#/$defs/stepGraphObservation" }
        },
        "errors": {
          "description": "Neutral application-lifecycle errors (m-detach / m-identity-map / m-unit-work) an adapter reports for scenario steps declaring `expectError`. Optional and additive — an adapter that raises no such error omits it, and existing run outputs stay valid.",
          "type": "array",
          "items": { "$ref": "#/$defs/errorObservation" }
        },
        "errorClass": {
          "description": "The neutral `m-db-error` category the final trigger statement's raised failure classified to on an error-shape run, compared against the case's `then.errorClass`. Distinct from the application-lifecycle `errors` observation (which has no native-code witness). Optional and additive — only error-shape runs report it, and existing run outputs stay valid.",
          "type": "string",
          "enum": ["uniqueViolation", "deadlock", "lockWaitTimeout"]
        },
        "nativeCode": {
          "description": "The preserved native code witness paired with `errorClass` (Postgres SQLSTATE string / MariaDB vendor errno integer), compared against the case's per-dialect `then.nativeCode`.",
          "type": ["string", "integer"]
        },
        "execution": {
          "description": "The execution provenance the run produced (m-execution-log), compared against the case's `then.execution`. Optional and additive — an adapter that reports no provenance omits it, and existing run outputs stay valid — but an adapter claiming `m-execution-log` MUST report it for every case authoring the oracle.",
          "$ref": "#/$defs/executionObservation"
        },
        "rejectedRule": {
          "description": "The classified normative rule identifier a rejected-case run refused the input with (m-predicate / m-navigate / m-value-object / m-inheritance), compared against the case's `then.rejectedRule`. An adapter whose claim includes the `rejected` caseShape MUST report this observation on a rejected-case run, with `roundTrips: 0` and no provisioning or dialect. Optional and additive at the schema layer — only rejected-shape runs report it, and existing run outputs stay valid.",
          "type": "string"
        }
      },
      "dependentRequired": {
        "errorClass": ["nativeCode"],
        "nativeCode": ["errorClass"]
      }
    },
    "wallTimeMs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95"],
      "properties": {
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "benchmarkWorkload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "iterations", "wallTimeMs", "roundTrips"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "wallTimeMs": {
          "$ref": "#/$defs/wallTimeMs"
        },
        "roundTrips": {
          "type": "integer",
          "minimum": 0
        },
        "expectRoundTrips": {
          "type": "integer",
          "minimum": 0
        },
        "roundTripsOk": {
          "type": "boolean"
        }
      }
    },
    "benchmarkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "model", "datasetRows", "workloads"],
      "properties": {
        "fixture": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "datasetRows": {
          "type": "integer",
          "minimum": 0
        },
        "workloads": {
          "type": "array",
          "items": { "$ref": "#/$defs/benchmarkWorkload" }
        }
      }
    },
    "benchmarkMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peakBytes", "steadyBytes"],
      "properties": {
        "peakBytes": {
          "type": "integer",
          "minimum": 0
        },
        "steadyBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "benchmarkReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt", "dialect", "benchmarks", "memory"],
      "properties": {
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "dialect": { "$ref": "#/$defs/dialect" },
        "benchmarks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/benchmarkEntry" }
        },
        "memory": { "$ref": "#/$defs/benchmarkMemory" }
      }
    },
    "commonOk": {
      "type": "object",
      "required": ["schemaVersion", "command", "status", "adapter"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "command": { "$ref": "#/$defs/command" },
        "status": { "const": "ok" },
        "adapter": { "$ref": "#/$defs/adapter" }
      }
    },
    "describeOk": {
      "allOf": [
        { "$ref": "#/$defs/commonOk" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "command", "status", "adapter", "capabilities"],
          "properties": {
            "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
            "command": { "const": "describe" },
            "status": { "const": "ok" },
            "adapter": { "$ref": "#/$defs/adapter" },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": ["modules", "dialects", "caseShapes", "commands", "provisioning"],
              "properties": {
                "modules": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/moduleTag" },
                  "uniqueItems": true
                },
                "dialects": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/dialect" },
                  "uniqueItems": true
                },
                "caseShapes": {
                  "$ref": "#/$defs/caseShapeList"
                },
                "caseTags": {
                  "$ref": "#/$defs/caseTagClaims"
                },
                "commands": {
                  "$ref": "#/$defs/commandList"
                },
                "provisioning": {
                  "type": "string",
                  "enum": ["external-url", "self-managed"]
                }
              }
            }
          }
        }
      ]
    },
    "compileOk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "status",
        "adapter",
        "case",
        "dialect",
        "caseShape",
        "emissions",
        "roundTrips"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "command": { "const": "compile" },
        "status": { "const": "ok" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "case": { "$ref": "#/$defs/casePath" },
        "dialect": { "$ref": "#/$defs/dialect" },
        "caseShape": { "$ref": "#/$defs/caseShape" },
        "emissions": { "$ref": "#/$defs/emissions" },
        "roundTrips": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "compileRunOnly": {
      "description": "The defined `compile` answer for a CLAIMED case the corpus declares RUN-ONLY (`compileEligibility`, m-case-format). Its emissions cannot be derived without executing SQL, so the adapter neither compiles it (that would require running a query) nor returns `unsupported` (invalid for a claimed case command). Instead it returns `status: run-only` with at least one `compile-run-only` diagnostic; only the `run` command grades the case. Exit code 11.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "status",
        "adapter",
        "case",
        "dialect",
        "caseShape",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "command": { "const": "compile" },
        "status": { "const": "run-only" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "case": { "$ref": "#/$defs/casePath" },
        "dialect": { "$ref": "#/$defs/dialect" },
        "caseShape": { "$ref": "#/$defs/caseShape" },
        "diagnostics": {
          "allOf": [
            { "$ref": "#/$defs/diagnostics" },
            {
              "description": "At least one diagnostic MUST carry the reserved code `compile-run-only` naming the run-only reason.",
              "contains": {
                "type": "object",
                "required": ["code"],
                "properties": { "code": { "const": "compile-run-only" } }
              }
            }
          ]
        }
      }
    },
    "runOk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "status",
        "adapter",
        "case",
        "dialect",
        "caseShape",
        "emissions",
        "observations"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "command": { "const": "run" },
        "status": { "const": "ok" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "case": { "$ref": "#/$defs/casePath" },
        "dialect": { "$ref": "#/$defs/dialect" },
        "caseShape": { "$ref": "#/$defs/caseShape" },
        "emissions": { "$ref": "#/$defs/emissions" },
        "observations": { "$ref": "#/$defs/observations" }
      }
    },
    "benchmarkOk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "status",
        "adapter",
        "benchmark",
        "report"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "command": { "const": "benchmark" },
        "status": { "const": "ok" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "benchmark": { "$ref": "#/$defs/benchmarkPath" },
        "report": { "$ref": "#/$defs/benchmarkReport" }
      }
    },
    "nonOk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "command", "status", "adapter", "diagnostics"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "command": { "$ref": "#/$defs/command" },
        "status": {
          "type": "string",
          "enum": ["unsupported", "error"]
        },
        "adapter": { "$ref": "#/$defs/adapter" },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      }
    }
  }
}
