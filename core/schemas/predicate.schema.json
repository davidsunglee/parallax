{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallax.dev/schemas/predicate.schema.json",
  "title": "Parallax Predicate Algebra (m-predicate)",
  "description": "Canonical, format-agnostic serialization of an m-predicate Predicate node: the RECURSIVE Boolean selection grammar and nothing else. Each node is a single-key tagged object. Every query-wide value — the queried position, result narrowing, ordering, the row cap, Temporal Selection, and Includes — is a sibling clause of the Object Query that carries this predicate (object-query.schema.json), so recursion buys composition of selection logic alone. Scalar operations read an object field through a `path` or, inside a scalar-collection quantifier, the bound element with no `path`; collections are reached only through the `any` / `all` / `none` quantifiers and single objects tested with `exists` / `notExists`. The narrow node here is PREDICATE-SCOPED: it is a filter rather than whole-result narrowing. Physical interval predicates are injected by m-temporal-read and never authored in a Predicate.",
  "$ref": "#/$defs/predicate",
  "$defs": {
    "literal": {
      "description": "A non-null serialized typed literal. After the subject resolves, model-aware elaboration decodes it exactly once with m-wire against the resolved NeutralType; null tests use dedicated predicate nodes. The schema intentionally does not duplicate per-type literal grammar.",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "path": {
      "description": "A predicate path: Entity-qualified at the queried position, relative to the bound object inside a quantifier `where` or a path-targeted narrowing (identity.schema.json). Model-aware validation admits the spelling its scope requires and resolves every segment against declared members, following single value objects and to-one relationships; it rejects a path that continues past a collection.",
      "anyOf": [
        {
          "$ref": "identity.schema.json#/$defs/qualifiedPath"
        },
        {
          "$ref": "identity.schema.json#/$defs/relativePath"
        }
      ]
    },
    "predicate": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        {
          "$ref": "#/$defs/true"
        },
        {
          "$ref": "#/$defs/false"
        },
        {
          "$ref": "#/$defs/eq"
        },
        {
          "$ref": "#/$defs/notEq"
        },
        {
          "$ref": "#/$defs/greaterThan"
        },
        {
          "$ref": "#/$defs/greaterThanEquals"
        },
        {
          "$ref": "#/$defs/lessThan"
        },
        {
          "$ref": "#/$defs/lessThanEquals"
        },
        {
          "$ref": "#/$defs/between"
        },
        {
          "$ref": "#/$defs/isNull"
        },
        {
          "$ref": "#/$defs/isNotNull"
        },
        {
          "$ref": "#/$defs/like"
        },
        {
          "$ref": "#/$defs/notLike"
        },
        {
          "$ref": "#/$defs/startsWith"
        },
        {
          "$ref": "#/$defs/endsWith"
        },
        {
          "$ref": "#/$defs/contains"
        },
        {
          "$ref": "#/$defs/in"
        },
        {
          "$ref": "#/$defs/notIn"
        },
        {
          "$ref": "#/$defs/and"
        },
        {
          "$ref": "#/$defs/or"
        },
        {
          "$ref": "#/$defs/not"
        },
        {
          "$ref": "#/$defs/group"
        },
        {
          "$ref": "#/$defs/any"
        },
        {
          "$ref": "#/$defs/all"
        },
        {
          "$ref": "#/$defs/none"
        },
        {
          "$ref": "#/$defs/exists"
        },
        {
          "$ref": "#/$defs/notExists"
        },
        {
          "$ref": "#/$defs/narrow"
        }
      ]
    },
    "true": {
      "description": "The constant true predicate: it selects every object its query reaches. A constant names no subject and is not a Boolean field test.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "true"
      ],
      "properties": {
        "true": {
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "false": {
      "description": "The constant false predicate: it selects nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false"
      ],
      "properties": {
        "false": {
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "comparison": {
      "description": "A comparison body: an object field (`path`) or, with no `path`, the scalar element a scalar-collection quantifier binds, compared against one non-null typed literal.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "value"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "value": {
              "$ref": "#/$defs/literal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/literal"
            }
          }
        }
      ]
    },
    "eq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eq"
      ],
      "properties": {
        "eq": {
          "$ref": "#/$defs/comparison"
        }
      }
    },
    "notEq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notEq"
      ],
      "properties": {
        "notEq": {
          "$ref": "#/$defs/comparison"
        }
      }
    },
    "greaterThan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "greaterThan"
      ],
      "properties": {
        "greaterThan": {
          "$ref": "#/$defs/comparison"
        }
      }
    },
    "greaterThanEquals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "greaterThanEquals"
      ],
      "properties": {
        "greaterThanEquals": {
          "$ref": "#/$defs/comparison"
        }
      }
    },
    "lessThan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessThan"
      ],
      "properties": {
        "lessThan": {
          "$ref": "#/$defs/comparison"
        }
      }
    },
    "lessThanEquals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessThanEquals"
      ],
      "properties": {
        "lessThanEquals": {
          "$ref": "#/$defs/comparison"
        }
      }
    },
    "range": {
      "description": "An inclusive range one value must satisfy whole: an object field or the bound scalar element, lower bound first.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "lower",
            "upper"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "lower": {
              "$ref": "#/$defs/literal"
            },
            "upper": {
              "$ref": "#/$defs/literal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower",
            "upper"
          ],
          "properties": {
            "lower": {
              "$ref": "#/$defs/literal"
            },
            "upper": {
              "$ref": "#/$defs/literal"
            }
          }
        }
      ]
    },
    "between": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "between"
      ],
      "properties": {
        "between": {
          "$ref": "#/$defs/range"
        }
      }
    },
    "nullCheck": {
      "description": "A null check reads an object field only; a collection element is never null.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "isNull": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isNull"
      ],
      "properties": {
        "isNull": {
          "$ref": "#/$defs/nullCheck"
        }
      }
    },
    "isNotNull": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isNotNull"
      ],
      "properties": {
        "isNotNull": {
          "$ref": "#/$defs/nullCheck"
        }
      }
    },
    "stringMatch": {
      "description": "A string predicate over an object field or the bound scalar element. `value` is a plain string; `like`/`notLike` interpret `%`/`_` as wildcards, the affix forms (startsWith/endsWith/contains) treat `value` as a literal and the implementation escapes wildcards. `caseInsensitive` defaults to false.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "value"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "value": {
              "type": "string"
            },
            "caseInsensitive": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "caseInsensitive": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    },
    "like": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "like"
      ],
      "properties": {
        "like": {
          "$ref": "#/$defs/stringMatch"
        }
      }
    },
    "notLike": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notLike"
      ],
      "properties": {
        "notLike": {
          "$ref": "#/$defs/stringMatch"
        }
      }
    },
    "startsWith": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startsWith"
      ],
      "properties": {
        "startsWith": {
          "$ref": "#/$defs/stringMatch"
        }
      }
    },
    "endsWith": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endsWith"
      ],
      "properties": {
        "endsWith": {
          "$ref": "#/$defs/stringMatch"
        }
      }
    },
    "contains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains"
      ],
      "properties": {
        "contains": {
          "$ref": "#/$defs/stringMatch"
        }
      }
    },
    "membership": {
      "description": "A membership test of an object field or the bound scalar element against a non-empty list of typed literals.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "values"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/literal"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/literal"
              }
            }
          }
        }
      ]
    },
    "in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in"
      ],
      "properties": {
        "in": {
          "$ref": "#/$defs/membership"
        }
      }
    },
    "notIn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notIn"
      ],
      "properties": {
        "notIn": {
          "$ref": "#/$defs/membership"
        }
      }
    },
    "junction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operands"
      ],
      "properties": {
        "operands": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/predicate"
          }
        }
      }
    },
    "and": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "and"
      ],
      "properties": {
        "and": {
          "$ref": "#/$defs/junction"
        }
      }
    },
    "or": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "or"
      ],
      "properties": {
        "or": {
          "$ref": "#/$defs/junction"
        }
      }
    },
    "not": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not"
      ],
      "properties": {
        "not": {
          "$ref": "#/$defs/unary"
        }
      }
    },
    "group": {
      "description": "An explicit precedence-nesting node. It wraps a single inner predicate so that a fluent or prefix surface that intends to group a sub-expression serializes to one unambiguous canonical form.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group"
      ],
      "properties": {
        "group": {
          "$ref": "#/$defs/unary"
        }
      }
    },
    "unary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operand"
      ],
      "properties": {
        "operand": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "quantifierBody": {
      "description": "The body of `any` / `none`: the collection at `path` — a scalar collection, a `many` value object, or a to-many relationship's related Entities — and an optional `where` binding one element. Without `where` the quantifier tests occupancy.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "where": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "universalBody": {
      "description": "The body of `all`: the collection at `path` and the `where` every element must make true; a universal has no bare form.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "where"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "where": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "any": {
      "description": "any(path[, where]): some element makes `where` true; bare, the collection holds an element.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "any"
      ],
      "properties": {
        "any": {
          "$ref": "#/$defs/quantifierBody"
        }
      }
    },
    "all": {
      "description": "all(path, where): every element makes `where` true — a false or unknown element fails it, and an empty collection satisfies it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "$ref": "#/$defs/universalBody"
        }
      }
    },
    "none": {
      "description": "none(path[, where]): no element makes `where` true; bare, the collection is empty or absent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "none"
      ],
      "properties": {
        "none": {
          "$ref": "#/$defs/quantifierBody"
        }
      }
    },
    "presenceBody": {
      "description": "The single object at `path` — a `one` value object or the Entity a to-one relationship reaches; a presence test carries no predicate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "exists": {
      "description": "exists(path): the single object is present.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exists"
      ],
      "properties": {
        "exists": {
          "$ref": "#/$defs/presenceBody"
        }
      }
    },
    "notExists": {
      "description": "notExists(path): the single object is absent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notExists"
      ],
      "properties": {
        "notExists": {
          "$ref": "#/$defs/presenceBody"
        }
      }
    },
    "narrow": {
      "description": "narrow(to, operand[, path]): constrain a POLYMORPHIC position to a Subtype Selection (m-predicate, m-inheritance). This is PREDICATE-SCOPED narrowing and therefore a filter. Without `path` it narrows the position the enclosing scope is at; with `path` it narrows the single related Entity that path reaches, which is false when absent or outside the selection. `operand` is evaluated over the narrowed position, and a subtype test alone carries the constant true operand. Whole-result narrowing is `narrowTo` on the Object Query and has no spelling here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrow"
      ],
      "properties": {
        "narrow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to",
            "operand"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "to": {
              "$ref": "subtype-selection.schema.json#/$defs/subtypeSelection"
            },
            "operand": {
              "$ref": "#/$defs/predicate"
            }
          }
        }
      }
    }
  }
}
