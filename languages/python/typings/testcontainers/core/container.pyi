"""Minimal local stub for the Testcontainers generic container."""

from typing import NamedTuple, Self

from testcontainers.core.network import Network
from testcontainers.core.wait_strategies import WaitStrategy

class ExecResult(NamedTuple):
    exit_code: int
    output: bytes

class DockerContainer:
    def __init__(self, image: str, *, user: str = ..., entrypoint: list[str] = ...) -> None: ...
    def with_env(self, key: str, value: str) -> Self: ...
    def with_exposed_ports(self, *ports: int) -> Self: ...
    def with_network(self, network: Network) -> Self: ...
    def with_network_aliases(self, *aliases: str) -> Self: ...
    def waiting_for(self, strategy: WaitStrategy) -> Self: ...
    def start(self) -> Self: ...
    def stop(self) -> None: ...
    def exec(self, command: list[str]) -> ExecResult: ...
    def get_container_host_ip(self) -> str: ...
    def get_exposed_port(self, port: int) -> int: ...
